
@'
# Python virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/

# OS files
.DS_Store
Thumbs.db

